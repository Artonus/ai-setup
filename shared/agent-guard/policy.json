{
  "mode": "shadow",
  "dbClients": ["psql", "mysql", "mariadb", "mongosh", "redis-cli", "sqlite3", "pg_restore", "pg_dumpall", "dropdb", "createdb", "mongo", "kubectl-cnpg", "kubectl cnpg"],
  "dynamicScriptShells": ["sh", "bash", "zsh", "dash", "ksh"],
  "scriptRunners": ["sh", "bash", "zsh", "dash", "ksh", "source", "."],
  "inlineInterpreters": {"python": ["-c"], "python3": ["-c"], "node": ["-e", "--eval", "-p"], "perl": ["-e", "-E"], "ruby": ["-e"]},
  "failClosedTools": ["eval"],
  "verbGated": {
    "kubectl": {
      "rule": "cluster-mutation",
      "valueOpts": ["-n", "--namespace", "--context", "--cluster", "--kubeconfig", "--user", "-s", "--server"],
      "readVerbs": ["get", "describe", "logs", "top", "events", "diff", "explain", "version", "api-resources", "config view"]
    },
    "helm": {
      "rule": "cluster-mutation",
      "valueOpts": ["-n", "--namespace", "--kube-context", "--kubeconfig"],
      "readVerbs": ["list", "get", "status", "show", "search", "template", "lint", "version", "history", "repo list"]
    },
    "flux": {
      "rule": "cluster-mutation",
      "valueOpts": ["-n", "--namespace", "--context", "--kubeconfig"],
      "readVerbs": ["get", "logs", "events", "check", "version", "tree", "stats"]
    },
    "talosctl": {
      "rule": "cluster-mutation",
      "valueOpts": ["-n", "--nodes", "-e", "--endpoints", "--talosconfig", "--context"],
      "readVerbs": ["get", "read", "logs", "dmesg", "version", "health", "containers", "services"]
    },
    "aws": {
      "rule": "cloud-mutation",
      "valueOpts": ["--profile", "--region", "--output", "--endpoint-url", "--query", "--color", "--ca-bundle"],
      "readVerbs": ["* describe-*", "* list-*", "* get-*", "* head-*", "s3 ls", "sts get-caller-identity", "dynamodb query", "dynamodb scan", "dynamodb batch-get-item"]
    },
    "terraform": {
      "rule": "cloud-mutation",
      "valueOpts": [],
      "readVerbs": ["plan", "validate", "fmt", "show", "output", "version", "state list", "state show"]
    },
    "tofu": {
      "rule": "cloud-mutation",
      "valueOpts": [],
      "readVerbs": ["plan", "validate", "fmt", "show", "output", "version", "state list", "state show"]
    }
  },
  "cloudRules": [
    {"tool": "aws", "match": "rds-data execute-statement", "rule": "db-cloud", "reason": "aws rds-data execute-statement runs SQL against a database"},
    {"tool": "aws", "match": "rds delete-*", "rule": "db-cloud", "reason": "aws rds delete-* removes a database resource"},
    {"tool": "aws", "match": "rds modify-*", "rule": "db-cloud", "reason": "aws rds modify-* changes a database resource"},
    {"tool": "aws", "match": "rds reboot-*", "rule": "db-cloud", "reason": "aws rds reboot-* restarts a database"},
    {
      "tool": "aws",
      "match": "dynamodb *",
      "except": ["dynamodb describe-*", "dynamodb list-*", "dynamodb get-item", "dynamodb batch-get-item", "dynamodb query", "dynamodb scan"],
      "rule": "db-cloud",
      "reason": "aws dynamodb non-read verb changes data"
    },
    {"tool": "aws", "match": "ssm start-session", "rule": "cloud-session", "reason": "aws ssm start-session opens an interactive session"},
    {"tool": "aws", "match": "ecs execute-command", "rule": "cloud-session", "reason": "aws ecs execute-command runs a command in a container"}
  ],
  "git": {
    "rule": "git-destructive",
    "valueOpts": ["-C", "-c", "--git-dir", "--work-tree", "--namespace"],
    "dangerousConfig": ["alias.*", "core.sshcommand", "core.pager", "*.command"],
    "dangerousEnv": ["GIT_SSH_COMMAND"],
    "dangerousReason": "git -c or GIT_SSH_COMMAND can run an arbitrary command",
    "patterns": [
      {"verb": "push", "args": ["--force", "--delete", "--mirror"], "argPrefixes": ["--force-with-lease", "+", ":"], "shortChars": ["f", "d"], "reason": "git push can overwrite or delete remote history"},
      {"verb": "reset", "args": ["--hard"], "reason": "git reset --hard discards local changes"},
      {"verb": "branch", "args": ["--delete"], "shortChars": ["D", "d"], "reason": "git branch delete removes a branch"},
      {"verb": "branch", "args": ["--force"], "shortChars": ["f", "M"], "reason": "git branch -f or -M moves or overwrites a branch"},
      {"verb": "rebase", "always": true, "reason": "git rebase rewrites history; whether the commits are already pushed cannot be known statically"},
      {"verb": "filter-branch", "always": true, "reason": "git filter-branch rewrites history"},
      {"verb": "filter-repo", "always": true, "reason": "git filter-repo rewrites history"},
      {"verb": "update-ref", "args": ["--delete"], "shortChars": ["d"], "reason": "git update-ref -d deletes a ref"},
      {"verb": "tag", "args": ["--delete"], "shortChars": ["d"], "reason": "git tag -d deletes a tag"},
      {"verb": "switch", "args": ["--force", "--discard-changes"], "shortChars": ["f", "C"], "reason": "git switch -f discards local changes"},
      {"verb": "clean", "args": ["--force"], "shortChars": ["f"], "reason": "git clean -f deletes untracked files"},
      {"verb": "checkout", "args": [".", "--", "--force"], "shortChars": ["f"], "reason": "git checkout . or -- discards local changes"},
      {"verb": "restore", "args": [".", "--worktree"], "shortChars": ["W"], "reason": "git restore of the worktree discards local changes"},
      {"verb": "stash", "sub": ["drop", "clear"], "reason": "git stash drop or clear loses stashed work"},
      {"verb": "reflog", "sub": ["expire"], "reason": "git reflog expire removes recovery points"},
      {"verb": "gc", "argPrefixes": ["--prune"], "reason": "git gc --prune deletes unreachable objects"}
    ]
  },
  "protectedPaths": ["~/.ssh", "~/.aws", "~/.claude", "~/.config", "~/.zshrc", "~/.zshenv", "~/.zprofile", "~/.bashrc", "~/.bash_profile", "~/.profile"],
  "aiSetup": {
    "rule": "ai-setup",
    "reason": "change the AI setup in the ai-setup repo",
    "paths": ["~/.claude", "~/.config/opencode"]
  },
  "secretPaths": ["~/.ssh/id_*", "~/.aws/credentials", "**/.env", "**/.env.*"],
  "secretExcept": ["*.pub", "*.example", "*.sample", "*.template"],
  "secretSafeTools": ["ls", "stat", "chmod", "chown", "test", "[", "[[", "cd", "pushd", "rm", "unlink", "touch", "echo", "printf", "ssh", "ssh-add", "ssh-keygen", "git add", "git check-ignore"],
  "pathTools": {"read": "read", "write": "write", "edit": "edit", "multiedit": "edit", "notebookedit": "edit"},
  "fileRules": {
    "rule": "file-destructive",
    "destructive": {
      "rm": [],
      "rmdir": [],
      "shred": ["-n", "--iterations", "-s", "--size", "--random-source"],
      "truncate": ["-s", "--size", "-r", "--reference"]
    },
    "overwrite": {
      "mv": ["-t", "--target-directory", "-S", "--suffix"],
      "cp": ["-t", "--target-directory", "-S", "--suffix"],
      "ln": ["-t", "--target-directory", "-S", "--suffix"],
      "install": ["-m", "--mode", "-o", "--owner", "-g", "--group", "-t", "--target-directory", "-S", "--suffix"]
    },
    "protectedInProject": [".git"],
    "rootWildcard": "^[*.?]+$",
    "tee": {"tools": ["tee"], "valueOpts": []},
    "moveSources": ["mv"],
    "inPlace": {
      "sed": {"valueOpts": ["-e", "--expression", "-f", "--file", "-l", "--line-length"], "scriptOpts": ["-e", "--expression", "-f", "--file"], "long": ["--in-place"]},
      "perl": {"valueOpts": ["-e", "-E", "-I", "-M", "-m"], "scriptOpts": ["-e", "-E"], "long": []}
    },
    "rsync": {"deletePrefixes": ["--delete", "--del"], "valueOpts": ["-e", "--rsh", "-f", "--filter", "--exclude", "--include", "--exclude-from", "--include-from", "--files-from", "--port", "--bwlimit", "--log-file", "--backup-dir", "--suffix", "--partial-dir", "-T", "--temp-dir", "--link-dest", "--compare-dest", "--max-size", "--min-size", "--chmod", "--chown", "--rsync-path", "--timeout", "--password-file"]},
    "find": {"actions": ["-delete"], "execFlags": ["-exec", "-execdir", "-ok", "-okdir"], "filters": ["-name", "-iname", "-path", "-ipath", "-wholename", "-regex", "-iregex", "-type", "-newer", "-mtime", "-mmin", "-atime", "-ctime", "-size", "-user", "-group", "-perm", "-empty", "-lname"]},
    "ddOutput": "of=",
    "writeRedirects": [">", ">>", ">|", "&>", "&>>", ">&"],
    "safeTargets": ["/dev/null", "/dev/stdout", "/dev/stderr", "/dev/tty", "/dev/fd/*"]
  }
}
