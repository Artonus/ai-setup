{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": false,
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      },
      "todoist": {
        "type": "remote",
        "url": "https://ai.todoist.net/mcp",
        "disabled": false
      },
      "trilium": {
        "type": "remote",
        "url": "https://trilium.example.com/mcp",
        "disabled": false,
        "headers": {
          "Authorization": "Bearer {env:TRILIUM_MCP_TOKEN}"
        }
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "@playwright/mcp@latest"],
        "disabled": false
      },
      "google-calendar": {
        "type": "remote",
        "url": "https://calendarmcp.googleapis.com/mcp/v1",
        "disabled": true,
        "oauth": {
          "client_id": "{env:GOOGLE_MCP_CLIENT_ID}",
          "client_secret": "{env:GOOGLE_MCP_CLIENT_SECRET}",
          "scope": "https://www.googleapis.com/auth/calendar.calendarlist.readonly https://www.googleapis.com/auth/calendar.events.freebusy https://www.googleapis.com/auth/calendar.events.readonly"
        }
      }
    }
  },
  "permissions": [
    { "action": "skill", "resource": "context7-mcp", "effect": "deny" },
    { "action": "skill", "resource": "diagnose", "effect": "deny" },
    { "action": "skill", "resource": "find-skills", "effect": "deny" },
    { "action": "skill", "resource": "tdd", "effect": "deny" },
    { "action": "skill", "resource": "to-issues", "effect": "deny" },
    { "action": "skill", "resource": "to-prd", "effect": "deny" },
    { "action": "skill", "resource": "write-a-skill", "effect": "deny" },
    { "action": "skill", "resource": "zoom-out", "effect": "deny" }
  ],
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ]
}
