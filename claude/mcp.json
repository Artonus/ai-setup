{
  "mcpServers": {
    "trilium": {
      "type": "http",
      "url": "${TRILIUM_MCP_URL}",
      "headers": {
        "Authorization": "Bearer ${TRILIUM_MCP_TOKEN}"
      }
    },
    "memory-search": {
      "type": "stdio",
      "command": "memory-search-mcp"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    }
  }
}
