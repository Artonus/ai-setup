{
  "mcpServers": {
    "trilium": {
      "type": "http",
      "url": "https://trilium.example.com/mcp",
      "headers": {
        "Authorization": "Bearer ${TRILIUM_MCP_TOKEN}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    }
  }
}
