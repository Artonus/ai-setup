{
  "mcpServers": {
    "trilium": {
      "type": "http",
      "url": "${TRILIUM_MCP_URL}",
      "headers": {
        "Authorization": "Bearer ${TRILIUM_MCP_TOKEN}"
      }
    },
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "memory-search": {
      "type": "stdio",
      "command": "memory-search-mcp"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "firecrawl": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "firecrawl-mcp"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    }
  }
}
