{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "tui": "fullscreen",
  "skillOverrides": {
    "brainstorming": "off",
    "context7-mcp": "off",
    "diagnose": "off",
    "find-skills": "off",
    "tdd": "off",
    "to-issues": "off",
    "to-prd": "off",
    "write-a-skill": "off",
    "zoom-out": "off"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --list:*)",
      "Bash(git branch --show-current:*)",
      "Bash(ls:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run view:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pytest:*)",
      "Bash(ruff check:*)",
      "Bash(go test:*)",
      "Bash(cargo test:*)",
      "Bash(cargo check:*)",
      "Bash(bash tests/run.sh:*)",
      "Bash(git stash push:*)",
      "Bash(git stash list:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(git diff --output:*)",
      "Bash(git log --output:*)",
      "Bash(git show --output:*)",
      "Bash(git switch -f:*)",
      "Bash(git switch --discard-changes:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r -f:*)",
      "Bash(rm --recursive --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git commit -a:*)",
      "Bash(git commit --amend:*)",
      "Bash(git commit --no-verify:*)"
    ],
    "defaultMode": "auto"
  },
  "effortLevel": "high",
  "theme": "dark",
  "editorMode": "normal",
  "verbose": true,
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": false
}
