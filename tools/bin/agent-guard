#!/usr/bin/env python3
"""agent-guard: policy helper for AI agent shell commands.

Usage: agent-guard parse|check|explain '<command>'
       agent-guard check-path <tool> <path>
       agent-guard decide   (request JSON on stdin)
       agent-guard claude   (Claude Code PreToolUse hook JSON on stdin)
"""
from __future__ import annotations

import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

from agent_guard.claude_hook import run_claude_hook  # noqa: E402
from agent_guard.decision import make_ctx, run_decision  # noqa: E402
from agent_guard.parse import parse_command  # noqa: E402
from agent_guard.rules import Ctx, decide_bash, decide_path, explain_bash, load_policy  # noqa: E402
from agent_guard.unwrap import unwrap  # noqa: E402


def _policy() -> dict:
    default = os.path.join(os.path.expanduser("~"), ".config", "agent-guard", "policy.json")
    return load_policy(os.environ.get("AGENT_GUARD_POLICY") or default)


def _ctx() -> Ctx:
    return make_ctx()


def _paths() -> tuple:
    home = os.path.expanduser("~")
    policy = os.environ.get("AGENT_GUARD_POLICY") or os.path.join(home, ".config", "agent-guard", "policy.json")
    log_path = os.environ.get("AGENT_GUARD_LOG") or os.path.join(home, ".local", "state", "agent-guard", "decisions.jsonl")
    return policy, log_path


def _claude() -> int:
    policy, log_path = _paths()
    try:
        text = sys.stdin.buffer.read().decode("utf-8", "replace")
    except Exception:
        text = ""
    _, out = run_claude_hook(text, policy, log_path)
    if out:
        print(out)
    return 0


def _decide() -> int:
    policy, log_path = _paths()
    try:
        request = json.loads(sys.stdin.buffer.read().decode("utf-8", "replace"))
    except Exception:
        request = None
    print(json.dumps(run_decision(request, policy, log_path)))
    return 0


def main(argv: list) -> int:
    if len(argv) == 3 and argv[1] == "parse":
        for inv in unwrap(parse_command(argv[2])):
            print(json.dumps({"argv": inv.argv, "via_xargs": inv.via_xargs, "opaque": inv.opaque}))
        return 0
    if len(argv) == 3 and argv[1] == "check":
        d = decide_bash(argv[2], _policy(), _ctx())
        print("none" if d.decision == "none" else "\t".join([d.decision, d.rule, d.reason]))
        return 0
    if len(argv) == 3 and argv[1] == "explain":
        for inv, d in explain_bash(argv[2], _policy(), _ctx()):
            tail = "%s\t%s" % (d.rule, d.reason) if d.decision != "none" else ""
            print("\t".join([json.dumps(inv.argv), d.decision, tail]).rstrip("\t"))
        return 0
    if len(argv) == 4 and argv[1] == "check-path":
        d = decide_path(argv[2], argv[3], _policy(), _ctx())
        print("none" if d.decision == "none" else "\t".join([d.decision, d.rule, d.reason]))
        return 0
    if len(argv) == 2 and argv[1] == "decide":
        return _decide()
    if len(argv) == 2 and argv[1] == "claude":
        return _claude()
    print("usage: agent-guard parse|check|explain '<command>' | check-path <tool> <path> | decide | claude", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
