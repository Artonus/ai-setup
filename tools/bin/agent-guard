#!/usr/bin/env python3
"""agent-guard: policy helper for AI agent shell commands.

Usage: agent-guard parse '<command>'
"""
from __future__ import annotations

import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

from agent_guard.parse import parse_command  # noqa: E402
from agent_guard.unwrap import unwrap  # noqa: E402


def main(argv: list) -> int:
    if len(argv) == 3 and argv[1] == "parse":
        for inv in unwrap(parse_command(argv[2])):
            print(json.dumps({"argv": inv.argv, "via_xargs": inv.via_xargs, "opaque": inv.opaque}))
        return 0
    print("usage: agent-guard parse '<command>'", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
