#!/usr/bin/env python3
"""meeting-daemon: tiny localhost HTTP daemon that lets a Tampermonkey userscript
start and stop `meeting-rec` while you are in a Google Meet call.

  meeting-daemon [run]     serve on 127.0.0.1 (default)
  meeting-daemon install   write a systemd user unit and enable --now
  meeting-daemon uninstall disable --now and remove the unit

Endpoints (POST needs the X-Meeting-Token header, JSON bodies):
  POST /start  {title, url}          start recording (one recording at a time)
  POST /ping   {code}                keep-alive; no ping for TIMEOUT seconds = stop
  POST /stop   {code, reason}        stop; reason "pagehide" waits GRACE seconds
  GET  /meet.user.js                 the userscript with token and port filled in

Environment: MEETING_REC_BIN (default meeting-rec), MEETING_DAEMON_PORT (17321),
MEETING_DAEMON_TIMEOUT (20), MEETING_DAEMON_GRACE (15), XDG_CONFIG_HOME.
For tests: MEETING_DAEMON_SYSTEMD_DIR, MEETING_DAEMON_SYSTEMCTL.
Creating the file ${XDG_CONFIG_HOME:-~/.config}/meeting-daemon/disabled makes /start refuse.
Python 3, standard library only. The token is never logged.
"""
import hashlib
import hmac
import json
import os
import re
import secrets
import shlex
import shutil
import signal
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

NAME = "meeting-daemon"
UNIT = NAME + ".service"
MEET_ORIGIN = "https://meet.google.com"
CODE_RE = re.compile(r"^https://meet\.google\.com/([a-z]{3}-[a-z]{4}-[a-z]{3})(?:[/?#]|$)")
MAX_BODY = 16 * 1024
HERE = Path(__file__).resolve().parent
TEMPLATE = HERE.parent / "lib" / "meet.user.js.tpl"


def log(msg):
    sys.stderr.write("%s: %s\n" % (NAME, msg))
    sys.stderr.flush()


# ---------------------------------------------------------------- config

def env_int(name, default):
    try:
        return int(os.environ.get(name, default))
    except ValueError:
        return default


def port():
    return env_int("MEETING_DAEMON_PORT", 17321)


def timeout_s():
    return env_int("MEETING_DAEMON_TIMEOUT", 20)


def grace_s():
    return env_int("MEETING_DAEMON_GRACE", 15)


def config_dir():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return Path(base) / NAME


def rec_cmd():
    return shlex.split(os.environ.get("MEETING_REC_BIN") or "meeting-rec")


def load_token():
    """Create the token on first run (mode 600) and return it."""
    d = config_dir()
    d.mkdir(parents=True, exist_ok=True)
    os.chmod(str(d), 0o700)
    f = d / "token"
    if f.exists():
        tok = f.read_text().strip()
        if tok:
            os.chmod(str(f), 0o600)
            return tok
    tok = secrets.token_hex(32)
    fd = os.open(str(f), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        fh.write(tok + "\n")
    os.chmod(str(f), 0o600)
    return tok


def render_userscript(token):
    tpl = TEMPLATE.read_text()
    version = "1.0.%d" % (int(hashlib.sha1(tpl.encode()).hexdigest()[:6], 16) % 100000)
    return (tpl.replace("@@PORT@@", str(port()))
               .replace("@@TOKEN@@", token)
               .replace("@@VERSION@@", version))


# ---------------------------------------------------------------- recorder

def meeting_code(url):
    m = CODE_RE.match(url or "")
    return m.group(1) if m else None


def clean_text(s, limit=200):
    s = "".join(ch for ch in str(s or "") if ch.isprintable()).strip().lstrip("-").strip()
    return s[:limit]


class Recorder:
    """Owns the 'is a recording running' state and the watchdog."""

    def __init__(self):
        self.lock = threading.RLock()
        self.recording = False
        self.code = None
        self.last_ping = 0.0
        self.stop_at = None  # pending (soft) stop or retry deadline

    # -- meeting-rec
    def _run(self, *args):
        try:
            return subprocess.run(rec_cmd() + list(args), stdin=subprocess.DEVNULL,
                                  timeout=60, start_new_session=True).returncode
        except (OSError, subprocess.SubprocessError) as e:
            log("meeting-rec %s failed: %s" % (args[0] if args else "", e))
            return 127

    def _state_file(self):
        return config_dir() / "state.json"

    def _save_code(self):
        try:
            if self.recording and self.code:
                self._state_file().write_text(json.dumps({"code": self.code}))
            else:
                self._state_file().unlink()
        except OSError:
            pass

    # -- state
    def sync(self):
        """Rebuild state after a (re)start of the daemon from `meeting-rec status`."""
        with self.lock:
            if self._run("status") == 0:
                self.recording = True
                self.last_ping = time.monotonic()  # grace: pages must ping within TIMEOUT
                self.stop_at = None
                try:
                    self.code = json.loads(self._state_file().read_text()).get("code")
                except (OSError, ValueError, AttributeError):
                    self.code = None
                log("recording already running (code %s), watching it" % (self.code or "unknown"))
            else:
                self.recording = False
                self.code = None
                self._save_code()

    def _same(self, code):
        return not self.code or not code or code == self.code

    def start(self, title, url):
        code = meeting_code(url)
        with self.lock:
            if (config_dir() / "disabled").exists():
                return 409, "disabled"
            if self.recording and self._run("status") != 0:
                self.recording = False  # stopped behind our back
            if self.recording:
                if not self._same(code):
                    return 409, "busy"
                self.code = self.code or code
                self.last_ping = time.monotonic()
                self.stop_at = None  # a reload re-joined: same session
                self._save_code()
                return 200, "already"
            args = ["start"]
            if title:
                args += ["--title", title]
            if url:
                args += ["--url", url]
            if self._run(*args) != 0:
                return 502, "error"
            self.recording = True
            self.code = code
            self.last_ping = time.monotonic()
            self.stop_at = None
            self._save_code()
            return 200, "started"

    def ping(self, code):
        with self.lock:
            if not self.recording:
                return 200, "idle"
            if not self._same(code):
                return 200, "ignored"
            self.last_ping = time.monotonic()
            self.stop_at = None
            return 200, "ok"

    def stop(self, code, soft):
        with self.lock:
            if not self.recording:
                return 200, "idle"
            if not self._same(code):
                return 200, "ignored"
            if soft:
                self.stop_at = time.monotonic() + grace_s()
                return 200, "pending"
            return self._do_stop()

    def _do_stop(self):
        if self._run("stop") == 0:
            self.recording = False
            self.code = None
            self.stop_at = None
            self._save_code()
            return 200, "stopped"
        self.stop_at = time.monotonic() + 5  # retry from the watchdog
        return 502, "error"

    def tick(self):
        with self.lock:
            if not self.recording:
                return
            now = time.monotonic()
            if self.stop_at is not None:
                if now >= self.stop_at:
                    log("stopping (page left)")
                    self._do_stop()
            elif now - self.last_ping > timeout_s():
                log("no ping for %ds, stopping" % timeout_s())
                self._do_stop()

    def watchdog(self, stop_event):
        while not stop_event.wait(0.5):
            try:
                self.tick()
            except Exception as e:  # keep the watchdog alive
                log("watchdog error: %r" % e)


# ---------------------------------------------------------------- http

class Handler(BaseHTTPRequestHandler):
    server_version = NAME
    sys_version = ""
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):  # never log headers or bodies
        pass

    def _send(self, code, body=b"", ctype="application/json"):
        if isinstance(body, (dict, list)):
            body = json.dumps(body).encode()
        elif isinstance(body, str):
            body = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Connection", "close")  # no CORS headers, ever
        self.end_headers()
        self.wfile.write(body)
        self.close_connection = True

    def _deny(self, code, why):
        self._send(code, {"ok": False, "error": why})

    def _guard(self):
        """Host and Origin checks. Returns True if the request may continue."""
        p = self.server.server_address[1]
        if self.headers.get("Host", "") not in ("127.0.0.1:%d" % p, "localhost:%d" % p):
            self._deny(403, "bad host")
            return False
        origin = self.headers.get("Origin")
        if origin is not None and origin != MEET_ORIGIN:
            self._deny(403, "bad origin")
            return False
        return True

    def do_GET(self):
        if not self._guard():
            return
        if self.path.split("?", 1)[0] == "/meet.user.js":
            try:
                body = render_userscript(self.server.token)
            except OSError:
                return self._deny(500, "template missing")
            return self._send(200, body, "text/javascript; charset=utf-8")
        self._deny(404, "not found")

    def do_OPTIONS(self):  # no CORS preflight is ever allowed
        self._deny(403, "forbidden")

    def do_POST(self):
        if not self._guard():
            return
        route = self.path.split("?", 1)[0]
        if route not in ("/start", "/ping", "/stop"):
            return self._deny(404, "not found")
        given = self.headers.get("X-Meeting-Token", "")
        if not hmac.compare_digest(given.encode(), self.server.token.encode()):
            return self._deny(403, "bad token")
        try:
            n = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            return self._deny(400, "bad length")
        if n < 0 or n > MAX_BODY:
            return self._deny(413, "too large")
        raw = self.rfile.read(n) if n else b""
        try:
            data = json.loads(raw.decode("utf-8")) if raw.strip() else {}
        except ValueError:
            return self._deny(400, "bad json")
        if not isinstance(data, dict):
            return self._deny(400, "bad json")

        rec = self.server.rec
        url = data.get("url") if isinstance(data.get("url"), str) else ""
        if route == "/start":
            if not meeting_code(url):
                return self._deny(400, "url is not a meeting")
            status, result = rec.start(clean_text(data.get("title")), url)
        else:
            code = data.get("code") if isinstance(data.get("code"), str) else meeting_code(url)
            if route == "/ping":
                status, result = rec.ping(code)
            else:
                status, result = rec.stop(code, data.get("reason") == "pagehide")
        self._send(status, {"ok": status == 200, "result": result, "recording": rec.recording})


class Server(ThreadingHTTPServer):
    daemon_threads = True


def cmd_run():
    token = load_token()
    rec = Recorder()
    rec.sync()
    try:
        srv = Server(("127.0.0.1", port()), Handler)
    except OSError as e:
        log("cannot listen on 127.0.0.1:%d: %s" % (port(), e))
        return 1
    srv.token = token
    srv.rec = rec
    stop_event = threading.Event()
    threading.Thread(target=rec.watchdog, args=(stop_event,), daemon=True).start()

    def bye(*_):
        threading.Thread(target=srv.shutdown, daemon=True).start()
    signal.signal(signal.SIGTERM, bye)
    signal.signal(signal.SIGINT, bye)
    log("listening on 127.0.0.1:%d, userscript at http://127.0.0.1:%d/meet.user.js" % (port(), port()))
    try:
        srv.serve_forever()
    finally:
        stop_event.set()
        srv.server_close()
    return 0


# ---------------------------------------------------------------- systemd

def unit_dir():
    d = os.environ.get("MEETING_DAEMON_SYSTEMD_DIR")
    if d:
        return Path(d)
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return Path(base) / "systemd" / "user"


def systemctl(*args):
    cmd = [os.environ.get("MEETING_DAEMON_SYSTEMCTL") or "systemctl", "--user"] + list(args)
    return subprocess.run(cmd).returncode


def q(s):  # systemd quoting
    return '"%s"' % str(s).replace("\\", "\\\\").replace('"', '\\"').replace("%", "%%")


def resolve_rec():
    configured = os.environ.get("MEETING_REC_BIN")
    if configured:
        return configured
    sibling = HERE / "meeting-rec"
    return shutil.which("meeting-rec") or (str(sibling) if sibling.exists() else "meeting-rec")


def cmd_install():
    token = load_token()  # make sure it exists before the service starts
    del token
    env = {"MEETING_REC_BIN": resolve_rec()}
    for k in ("MEETING_DAEMON_PORT", "MEETING_DAEMON_TIMEOUT", "MEETING_DAEMON_GRACE", "XDG_CONFIG_HOME"):
        if os.environ.get(k):
            env[k] = os.environ[k]
    lines = [
        "[Unit]",
        "Description=Meet recording daemon (127.0.0.1 only)",
        "",
        "[Service]",
        "Type=simple",
        "ExecStart=%s %s run" % (q(sys.executable), q(Path(__file__).resolve())),
    ]
    lines += ["Environment=%s" % q("%s=%s" % kv) for kv in sorted(env.items())]
    lines += [
        "Restart=on-failure",
        "RestartSec=2",
        "KillMode=process",  # restarting the daemon must not kill a running recording
        "",
        "[Install]",
        "WantedBy=default.target",
        "",
    ]
    d = unit_dir()
    d.mkdir(parents=True, exist_ok=True)
    (d / UNIT).write_text("\n".join(lines))
    if systemctl("daemon-reload") != 0 or systemctl("enable", "--now", UNIT) != 0:
        log("systemctl failed")
        return 1
    print("Installed %s. Install the userscript from http://127.0.0.1:%d/meet.user.js" % (UNIT, port()))
    return 0


def cmd_uninstall():
    systemctl("disable", "--now", UNIT)
    f = unit_dir() / UNIT
    if f.exists():
        f.unlink()
    systemctl("daemon-reload")
    print("Removed %s (token kept in %s)" % (UNIT, config_dir()))
    return 0


def main(argv):
    sub = argv[1] if len(argv) > 1 else "run"
    cmds = {"run": cmd_run, "install": cmd_install, "uninstall": cmd_uninstall}
    if sub not in cmds:
        sys.stderr.write("usage: meeting-daemon [run|install|uninstall]\n")
        return 2
    return cmds[sub]()


if __name__ == "__main__":
    sys.exit(main(sys.argv))
